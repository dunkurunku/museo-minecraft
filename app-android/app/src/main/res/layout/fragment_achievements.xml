<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="5"
    android:background="#121212">

    <!-- 3.8/5 SUPERIOR: La Rejilla de Logros -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.8"
        android:padding="8dp"
        android:background="@drawable/fondo_logros">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TUS LOGROS"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAchievements"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3"
            app:layout_constraintTop_toBottomOf="@+id/tvHeader"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/item_achievement" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DIVISOR VISUAL NARANJA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#FF9800"/>

    <!-- 1.2/5 INFERIOR: Detalle -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:background="#212121"
        android:padding="16dp">

        <!-- Icono grande a la izquierda -->
        <ImageView
            android:id="@+id/ivSelectedIcon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="#616161"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Título del Logro -->
        <TextView
            android:id="@+id/tvAchievementTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Selecciona un logro"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivSelectedIcon"
            app:layout_constraintTop_toTopOf="@+id/ivSelectedIcon" />

        <!-- Estado -->
        <TextView
            android:id="@+id/tvAchievementStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="TOCA UN LOGRO ARRIBA"
            android:textSize="10sp"
            android:textColor="#B0B0B0"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/tvAchievementTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvAchievementTitle" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvAchievementDesc"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:text="Toca los iconos de la cuadrícula superior para ver detalles."
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:ellipsize="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivSelectedIcon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>