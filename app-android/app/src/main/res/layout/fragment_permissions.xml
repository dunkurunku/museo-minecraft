<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/onboarding_fondo"
    android:padding="24dp">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/tv_title_permissions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="PERMISOS NECESARIOS"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"

        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CONTENEDOR DESCRIPCIÓN (Con fondo oscuro para leerse bien) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_desc_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#BF000000"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title_permissions">

        <TextView
            android:id="@+id/tv_desc_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Descripción de permisos..."
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- LISTA DE PERMISOS  -->
    <LinearLayout
        android:id="@+id/layout_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/card_desc_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CÁPSULA 1: CÁMARA -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:layout_marginHorizontal="16dp"
            app:cardBackgroundColor="#33000000"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#00FFCC"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tv_perm_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="📷 Cámara: Escáner QR"
                android:textColor="#00FFCC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- CÁPSULA 2: SENSORES -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:layout_marginHorizontal="16dp"
            app:cardBackgroundColor="#33000000"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#00FFCC"
            app:strokeWidth="1dp">
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- BOTÓN DE ACCIÓN  -->
    <Button
        android:id="@+id/btn_grant_permissions"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginBottom="32dp"
        android:layout_marginHorizontal="32dp"
        android:backgroundTint="#4CAF50"
        android:text="CONCEDER PERMISOS"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="30dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_next_permissions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- FLECHA SIGUIENTE -->
    <ImageButton
        android:id="@+id/btn_next_permissions"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_media_play"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#00FFCC" />

</androidx.constraintlayout.widget.ConstraintLayout>